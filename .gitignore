_theme-preview.html

# Never commit a key. The proxy reads it from an environment variable or from a
# file above the document root, so nothing here should ever hold one -- these
# patterns exist so a mistake fails at `git add` rather than in public.
*.key
*.pem
.env
.env.*
private/

# Eval output. Written per run, never committed: a graded report in the
# repository would be read as the current behaviour of an endpoint that changes
# whenever the brief or the model does.
dev/eval-report.json

# Local Claude Code skills (brag-slim, from latent-spaces/brag @ 7079945) and
# the launch videos it writes. Plesk deploys this repo to the web root, so
# anything committed here is publicly served on ziyaduqdah.com.
.claude/
brag-output*/
